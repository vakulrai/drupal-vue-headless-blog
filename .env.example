# Copy to .env for local development. Never commit the real .env file.

# Database (MariaDB container locally, Aiven MySQL in production)
DB_NAME=drupal
DB_USER=drupal
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me-too

# Drupal
# Generate with: php -r "echo bin2hex(random_bytes(32));"
DRUPAL_HASH_SALT=replace-with-a-long-random-string
DRUPAL_SITE_NAME=Headless Blog
DRUPAL_ADMIN_USER=admin
DRUPAL_ADMIN_PASS=change-me
DRUPAL_ADMIN_MAIL=admin@example.com
TRUSTED_HOST_PATTERNS=^localhost$,^127\.0\.0\.1$

# Comma separated origins allowed to call the API (the Vue app)
CORS_ALLOWED_ORIGINS=http://localhost:5173
# "Lax" works locally (same site); production uses "None" because Vue and Drupal live on different domains
SESSION_COOKIE_SAMESITE=Lax
