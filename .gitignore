# Environment / secrets
.env
.env.*
!.env.example
*.pem

# Drupal: dependencies are installed by Composer, never committed
drupal/vendor/
drupal/web/core/
drupal/web/modules/contrib/
drupal/web/themes/contrib/
drupal/web/profiles/contrib/
drupal/web/libraries/
drupal/recipes/
drupal/web/sites/*/files/
drupal/web/sites/*/private/
drupal/web/sites/*/settings.local.php
drupal/web/sites/*/services.local.yml
# Scaffold files are regenerated by drupal/core-composer-scaffold
drupal/web/*.php
drupal/web/.htaccess
drupal/web/.ht.router.php
drupal/web/robots.txt
drupal/web/web.config
drupal/web/*.txt
drupal/web/sites/*.php
drupal/web/sites/*.yml
drupal/web/sites/*.txt
drupal/web/sites/default/default.*
drupal/web/modules/README.txt
drupal/web/themes/README.txt
drupal/web/profiles/README.txt
drupal/web/.csslintrc
drupal/web/.eslintrc.json
drupal/web/.eslintignore
drupal/web/.prettierignore
drupal/web/.prettierrc.json
drupal/web/.stylelintrc.json
drupal/web/README.md
drupal/web/example.gitignore
drupal/.editorconfig
drupal/.gitattributes

# Frontend
node_modules/
frontend/dist/
frontend/coverage/
.vercel

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/
*.log
