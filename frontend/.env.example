# Base URL of the Drupal API (no trailing slash).
# Local docker-compose: http://localhost:8080
# Production (Vercel): https://<your-project>.vercel.app/cms
#   /cms is proxied to Drupal by vercel.json, so the login cookie is first-party.
VITE_DRUPAL_API_URL=http://localhost:8080

# Optional: where the "Open Drupal admin" button points. Defaults to VITE_DRUPAL_API_URL.
# Production: https://<your-drupal-service>.onrender.com
VITE_DRUPAL_ADMIN_URL=

# Optional: name shown in the header and page titles
VITE_SITE_NAME=Headless Blog
